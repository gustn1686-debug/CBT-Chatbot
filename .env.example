# 이 파일을 복사해서 .env 를 만들고 값을 채우세요. (.env 는 절대 커밋하지 않음)

# --- Backend ---
# 로컬: SQLite / 배포: Supabase(Postgres) 연결 문자열
DATABASE_URL=sqlite:///./synap.db
JWT_SECRET=change-me
# 가입 유도를 띄울 회기(세션) 수
GUEST_SESSION_LIMIT=3
CORS_ORIGINS=http://localhost:5173
# 보관 기간(일): 비회원 계정·대화 / 회원 대화 내용
GUEST_RETENTION_DAYS=30
MEMBER_RETENTION_DAYS=60
# 위기 감지 기록의 비식별 코드(HMAC) 비밀키. 절대 커밋/공유 금지
CRISIS_LOG_SECRET=change-me

# --- LLM ---
# mock: 임시 응답 / http: OpenAI 호환 엔드포인트 호출
LLM_MODE=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 모델 서버 보호: 동시 호출 제한 · 타임아웃 (초). 값은 기본값이며 필요할 때만 바꾼다
# LLM_MAX_CONCURRENT=8            # 대화 응답을 동시에 생성할 수 있는 요청 수
# LLM_MAX_QUEUE=8                 # 빈 자리를 기다리는 줄 길이. 넘으면 바로 "이용자가 많아요"
# LLM_QUEUE_WAIT_SECONDS=20       # 빈 자리를 기다리는 최대 시간
# LLM_FIRST_TOKEN_TIMEOUT=60      # 첫 글자가 올 때까지
# LLM_IDLE_TIMEOUT=30             # 글자 사이가 이 시간 넘게 비면 중단
# LLM_TOTAL_TIMEOUT=180           # 응답 하나의 전체 시간 상한
# LLM_SUMMARY_MAX_CONCURRENT=1    # 회기 요약 동시 실행 수
# LLM_SUMMARY_TIMEOUT=120

# --- CTRS judge (model/eval/ctrs_judge) ---
OPENAI_API_KEY=

# --- Frontend ---
# 백엔드가 준비되기 전에는 mock 사용 (src/api 의 목업 데이터)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCK=true
