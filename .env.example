# 이 파일을 복사해서 .env 를 만들고 값을 채우세요. (.env 는 절대 커밋하지 않음)

# --- Backend ---
# 로컬: SQLite / 배포: Supabase(Postgres) 연결 문자열
DATABASE_URL=sqlite:///./synap.db
JWT_SECRET=change-me
# 가입 유도를 띄울 회기(세션) 수
GUEST_SESSION_LIMIT=3
CORS_ORIGINS=http://localhost:5173
# 보관 기간(일): 비회원 계정·대화 / 회원 대화 내용
GUEST_RETENTION_DAYS=30
MEMBER_RETENTION_DAYS=60
# 위기 감지 기록의 비식별 코드(HMAC) 비밀키. 절대 커밋/공유 금지
CRISIS_LOG_SECRET=change-me

# --- LLM ---
# mock: 임시 응답 / http: OpenAI 호환 엔드포인트 호출
LLM_MODE=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- CTRS judge (model/eval/ctrs_judge) ---
OPENAI_API_KEY=

# --- Frontend ---
# 백엔드가 준비되기 전에는 mock 사용 (src/api 의 목업 데이터)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCK=true
